{
  "name": "gittoolvsc",
  "displayName": "Git Tool",
  "description": "A complete Git tool for VS Code: Git context menu, log with graph and branches, file history, blame, commit and shelf panels, interactive rebase.",
  "version": "0.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/arminmajerie/GitToolVSC.git"
  },
  "homepage": "https://github.com/arminmajerie/GitToolVSC",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1030",
    "theme": "dark"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Git Tool",
      "properties": {
        "vscgit.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Switch the current repository to the repository of the active editor."
        },
        "vscgit.logMaxCount": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "description": "Number of commits loaded at a time in the Git log."
        },
        "vscgit.fetchPrune": {
          "type": "boolean",
          "default": true,
          "description": "Prune deleted remote branches when fetching."
        },
        "vscgit.repositoryScanDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "How many folder levels below each workspace folder are scanned for Git repositories."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscgit",
          "title": "Git Tool",
          "icon": "media/git-tool.svg"
        }
      ],
      "panel": [
        {
          "id": "vscgitPanel",
          "title": "Git",
          "icon": "media/git-tool.svg"
        }
      ]
    },
    "views": {
      "vscgit": [
        {
          "type": "webview",
          "id": "vscgit.commit",
          "name": "Commit"
        }
      ],
      "vscgitPanel": [
        {
          "type": "webview",
          "id": "vscgit.branches",
          "name": "Branches"
        },
        {
          "type": "webview",
          "id": "vscgit.log",
          "name": "Log"
        },
        {
          "type": "webview",
          "id": "vscgit.changes",
          "name": "Changes"
        }
      ]
    },
    "colors": [
      {
        "id": "vscgit.stagedModifiedForeground",
        "description": "Staged files that already exist in the repository (badge S).",
        "defaults": {
          "dark": "#73C991",
          "light": "#2E7D32",
          "highContrast": "#73C991",
          "highContrastLight": "#2E7D32"
        }
      },
      {
        "id": "vscgit.stagedAddedForeground",
        "description": "Staged new files (badge S).",
        "defaults": {
          "dark": "#4FA3E0",
          "light": "#1A66B3",
          "highContrast": "#6FC3DF",
          "highContrastLight": "#1A66B3"
        }
      }
    ],
    "commands": [
      {
        "command": "vscgit.add",
        "title": "Add",
        "category": "Git Tool",
        "icon": "$(add)"
      },
      {
        "command": "vscgit.annotate",
