        },
        {
          "command": "vscgit.ch.stage",
          "group": "2_stage@1",
          "when": "webviewSection == 'change' && changeGroup != 'staged'"
        },
        {
          "command": "vscgit.ch.unstage",
          "group": "2_stage@2",
          "when": "webviewSection == 'change' && changeGroup == 'staged'"
