    "submenus": [
      {
        "id": "vscgit.resource",
        "label": "Git"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "vscgit.resource",
          "group": "z_vscgit@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "vscgit.resource",
          "group": "z_vscgit@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "vscgit.resource",
          "group": "z_vscgit@1",
          "when": "resourceScheme == file"
        }
      ],
      "vscgit.resource": [
        {
          "command": "vscgit.add",
          "group": "1_add@1"
        },
        {
          "command": "vscgit.annotate",
          "group": "2_compare@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "vscgit.showDiff",
          "group": "2_compare@2"
        },
        {
          "command": "vscgit.compareWithRevision",
          "group": "2_compare@3"
        },
        {
          "command": "vscgit.compareWithBranch",
          "group": "2_compare@4"
        },
        {
          "command": "vscgit.showHistory",
          "group": "2_compare@5"
        },
        {
          "command": "vscgit.showHistoryForSelection",
          "group": "2_compare@6",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "vscgit.showCurrentRevision",
          "group": "2_compare@7"
        },
        {
          "command": "vscgit.rollback",
          "group": "2_compare@8"
        },
        {
          "command": "vscgit.showStagedVersion",
          "group": "2_compare@9",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "vscgit.compareWithStaged",
          "group": "2_compare@10",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "vscgit.compareHeadStagedLocal",
          "group": "2_compare@11",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "vscgit.push",
          "group": "3_sync@1"
        },
        {
          "command": "vscgit.pull",
          "group": "3_sync@2"
        },
        {
          "command": "vscgit.fetch",
          "group": "3_sync@3"
        },
        {
          "command": "vscgit.merge",
          "group": "4_merge@1"
        },
        {
          "command": "vscgit.rebase",
          "group": "4_merge@2"
        },
        {
          "command": "vscgit.branches",
          "group": "5_branch@1"
        },
        {
          "command": "vscgit.newBranch",
          "group": "5_branch@2"
        },
        {
          "command": "vscgit.newTag",
          "group": "5_branch@3"
        },
        {
          "command": "vscgit.resetHead",
          "group": "5_branch@4"
        },
        {
          "command": "vscgit.stash",
          "group": "6_stash@1"
        },
        {
          "command": "vscgit.unstash",
          "group": "6_stash@2"
        },
        {
          "command": "vscgit.manageRemotes",
          "group": "7_remote@1"
        },
        {
          "command": "vscgit.clone",
          "group": "7_remote@2"
        }
      ],
      "webview/context": [
        {
          "command": "vscgit.br.checkout",
          "group": "1_checkout@1",
          "when": "webviewSection == 'branch' && !isCurrent"
        },
        {
          "command": "vscgit.br.newBranchFrom",
          "group": "1_checkout@2",
          "when": "webviewSection == 'branch'"
        },
        {
          "command": "vscgit.br.checkoutRebase",
          "group": "1_checkout@3",
          "when": "webviewSection == 'branch' && branchKind == 'local' && !isCurrent"
        },
        {
          "command": "vscgit.br.compare",
          "group": "2_compare@1",
          "when": "webviewSection == 'branch' && !isCurrent"
        },
        {
          "command": "vscgit.br.diffWorking",
