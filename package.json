    "walkthroughs": [
      {
        "id": "tour",
        "title": "Git Tool: Feature Tour",
        "description": "Where to find the Git views and how to use them.",
        "steps": [
          {
            "id": "log",
            "title": "Branches, Log and Changes",
            "description": "Three views in the bottom panel, tab GIT (Alt+9). Double-click a branch, select one or several commits (Ctrl/Shift+click) and right-click for cherry-pick, revert, squash, drop, compare and more.\n[Open the Log](command:vscgit.openLog)",
            "media": {
              "image": "assets/log.gif",
              "altText": "Branches, Log and Changes views"
            }
          },
          {
            "id": "menu",
            "title": "Git menu on files and folders",
            "description": "Right-click a file or folder in the Explorer, the editor or an editor tab and open Git: blame, diff, compare with revision/branch/staged, history, rollback, push, pull, branches, stash and more. Staged files get an S badge: green = changed, blue = new.",
            "media": {
              "image": "assets/explorer.gif",
              "altText": "Git right-click menu"
            }
          },
          {
            "id": "commit",
            "title": "Commit and Shelf",
            "description": "Activity bar, Git Tool icon (Alt+0): stage, unstage, rollback, amend, message history, Commit and Push. The Shelf tab lists your stashes.\n[Open Commit](command:vscgit.openCommit)",
            "media": {
              "image": "assets/commit.gif",
              "altText": "Commit and Shelf"
            }
          },
          {
            "id": "rebase",
            "title": "Interactive rebase",
            "description": "Log, right-click a commit, Interactively Rebase from Here: pick, reword, edit, squash, fixup or drop, and reorder with drag and drop or Alt+Up/Down.\n[Open the README](command:vscgit.readme)",
            "media": {
              "image": "assets/rebase.gif",
              "altText": "Interactive rebase editor"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "vscgit.openLog",
        "key": "alt+9"
      },
      {
        "command": "vscgit.openCommit",
        "key": "alt+0"
      }
    ]
  },
  "scripts": {
    "compile": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
