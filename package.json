        },
        {
          "command": "vscgit.br.push",
          "group": "4_sync@2",
          "when": "webviewSection == 'branch' && branchKind == 'local'"
        },
        {
          "command": "vscgit.br.rename",
          "group": "5_edit@1",
          "when": "webviewSection == 'branch' && branchKind == 'local'"
        },
        {
          "command": "vscgit.br.delete",
          "group": "5_edit@2",
          "when": "webviewSection == 'branch' && !isCurrent"
        },
        {
          "command": "vscgit.br.favorite",
          "group": "5_edit@3",
          "when": "webviewSection == 'branch'"
        },
        {
          "command": "vscgit.br.copyName",
          "group": "5_edit@4",
          "when": "webviewSection == 'branch'"
        },
        {
          "command": "vscgit.c.copyHash",
          "group": "1_copy@1",
          "when": "webviewSection == 'commit'"
        },
        {
          "command": "vscgit.c.createPatch",
          "group": "1_copy@2",
          "when": "webviewSection == 'commit'"
        },
        {
          "command": "vscgit.c.cherryPick",
          "group": "1_copy@3",
          "when": "webviewSection == 'commit'"
        },
        {
          "command": "vscgit.c.checkout",
          "group": "2_compare@1",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.showRepository",
          "group": "2_compare@2",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.showChanges",
          "group": "2_compare@3",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.compareWithLocal",
          "group": "2_compare@4",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.compareVersions",
          "group": "2_compare@5",
          "when": "webviewSection == 'commit' && commitCount == 2"
        },
        {
          "command": "vscgit.c.reset",
          "group": "3_apply@1",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.revert",
          "group": "3_apply@2",
          "when": "webviewSection == 'commit'"
        },
        {
          "command": "vscgit.c.undo",
          "group": "3_apply@3",
          "when": "webviewSection == 'commit' && isHead"
        },
        {
          "command": "vscgit.c.editMessage",
          "group": "4_rewrite@1",
          "when": "webviewSection == 'commit' && !multi && !isMerge"
        },
        {
          "command": "vscgit.c.fixup",
          "group": "4_rewrite@2",
          "when": "webviewSection == 'commit' && !multi && !isMerge"
        },
        {
          "command": "vscgit.c.squashInto",
          "group": "4_rewrite@3",
          "when": "webviewSection == 'commit' && !multi && !isMerge"
        },
        {
          "command": "vscgit.c.interactiveRebase",
          "group": "4_rewrite@6",
          "when": "webviewSection == 'commit' && !multi && !isMerge"
        },
        {
          "command": "vscgit.c.drop",
          "group": "4_rewrite@4",
          "when": "webviewSection == 'commit'"
        },
        {
          "command": "vscgit.c.squash",
          "group": "4_rewrite@5",
          "when": "webviewSection == 'commit' && multi"
        },
        {
          "command": "vscgit.c.pushUpTo",
          "group": "4_rewrite@7",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.newBranch",
          "group": "5_ref@1",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.newTag",
          "group": "5_ref@2",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.goChild",
          "group": "6_nav@1",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.c.goParent",
          "group": "6_nav@2",
          "when": "webviewSection == 'commit' && !multi"
        },
        {
          "command": "vscgit.f.showDiff",
          "group": "1_diff@1",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.f.compareWithLocal",
          "group": "1_diff@2",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.f.openRevision",
          "group": "2_open@1",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.f.openFile",
          "group": "2_open@2",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.f.history",
          "group": "3_history@1",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.f.getFromRevision",
          "group": "4_apply@1",
          "when": "webviewSection == 'commitFile'"
        },
        {
          "command": "vscgit.ch.diff",
          "group": "1_diff@1",
          "when": "webviewSection == 'change'"
        },
        {
          "command": "vscgit.ch.open",
          "group": "1_diff@2",
